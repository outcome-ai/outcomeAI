  function modalRT(){
    return `
      <div class="rt-modal">
        <header class="x-head">
          <div class="x-head__row">
            <h2 class="x-title">Resolved Today</h2>
            <span class="x-pill">LIVE</span>
          </div>
          <div class="x-hero">
            <div class="x-hero__value">$6,900</div>
            <div class="x-hero__label">saved today</div>
          </div>
          <div class="x-sub">4 loops closed • Updated 2 minutes ago</div>
        </header>

        <section class="x-insight">
          <p class="x-copy"><strong>This is what “handled” looks like.</strong><br/>Outcome turns silent risk into documented decisions.</p>
          <div class="x-stats">
            <div class="x-stat"><div class="x-k">Fastest resolve</div><div class="x-v">12 min</div></div>
            <div class="x-stat"><div class="x-k">Avg time to ownership</div><div class="x-v">38 min</div></div>
          </div>
        </section>

        <section class="x-list">
          ${rtCard("Online Buy Opportunity — 2020 F-150 Lariat","Lead #B1102","+ $2,400 captured",
            ["Action: Released (offer sent)","Owner: GM","10:12 AM • 24 min from alert"],
            "Speed captured the trade before the customer shopped it."
          )}
          ${rtCard("Service Retention Lead","RO #774102","+ $1,900 protected",
            ["Action: Assigned (outreach confirmed)","Owner: Service Lead","1:40 PM • 18 min from alert"],
            "Ownership ensured the customer didn’t pass through unseen."
          )}
          ${rtCard("Used Car Buy Decision","Stock #U2381","+ $1,400 protected",
            ["Action: Decision logged (buy approved)","Owner: Used Car Mgr","2:22 PM • 41 min from alert"],
            "Logging a decision stopped the clock and prevented escalation."
          )}
          ${rtCard("Online Appraisal Review","Customer #A1193","+ $1,200 captured",
            ["Action: Counter sent","Owner: GM","3:08 PM • 12 min from alert"],
            "Fast counter increased trade capture probability."
          )}
        </section>

        <section class="x-memory">
          <div class="x-memory__h">Outcome AI remembers</div>
          <ul class="x-bul">
            <li>2 items were within <strong>6 hours</strong> of escalation when handled.</li>
            <li>Most effective move today: <strong>immediate ownership assignment</strong>.</li>
            <li>All resolved items were prevented from moving into <strong>Cost of Inaction</strong>.</li>
          </ul>
        </section>

        <footer class="x-foot"><span class="x-foot__note">Handled beats perfect — repeat what worked.</span></footer>
