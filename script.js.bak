
/* FIX9f: Robust drawer mode switch (prevents Focus -> Top content bleed) */
(function(){
  function $(sel, root=document){ return root.querySelector(sel); }
  function ensureFocusContainer(){
    const drawer = $(".js-drawer") || $(".drawer");
    const body = (drawer && drawer.querySelector(".drawer__body")) || $(".drawer__body") || $("#drawerBody");
    if(!body) return null;
    let focus = body.querySelector("#drawerFocus");
    if(!focus){
      focus = document.createElement("div");
      focus.id = "drawerFocus";
      focus.style.display = "none";
      body.appendChild(focus);
    }
    return {drawer, body, focus};
  }

  window.__OutcomeDrawer = window.__OutcomeDrawer || {};
  window.__OutcomeDrawer.showFocus = function(html, title, subtitle){
    const pack = ensureFocusContainer();
    if(!pack) return;
    const {drawer, body, focus} = pack;

    // Hide standard content
    Array.from(body.children).forEach(ch=>{ if(ch !== focus) ch.style.display = "none"; });
    focus.style.display = "block";
    focus.innerHTML = html || "";
    if(drawer) drawer.dataset.mode = "focus";

    // Title/subtitle (safe)
    const t = body.querySelector(".js-drawerTitle") || document.querySelector(".js-drawerTitle") || body.querySelector(".drawer__title");
    const s = body.querySelector(".js-drawerSubtitle") || document.querySelector(".js-drawerSubtitle") || body.querySelector(".drawer__subtitle");
    if(t && typeof title === "string") t.textContent = title;
    if(s && typeof subtitle === "string") s.textContent = subtitle;
  };

  window.__OutcomeDrawer.restoreTop = function(){
    const pack = ensureFocusContainer();
    if(!pack) return;
    const {drawer, body, focus} = pack;

    // Hide focus, show standard
    if(focus){
      focus.style.display = "none";
      focus.innerHTML = "";
    }
    Array.from(body.children).forEach(ch=>{ if(ch !== focus) ch.style.display = ""; });
    if(drawer) drawer.dataset.mode = "top";
  };

  window.__OutcomeDrawer.clearAll = function(){
    const pack = ensureFocusContainer();
    if(!pack) return;
    const {body, focus} = pack;
    if(focus){ focus.style.display="none"; focus.innerHTML=""; }
    try{
      const t = document.querySelector(".js-drawerTitle");
      const s = document.querySelector(".js-drawerSubtitle");
      if(t) t.textContent = "";
      if(s) s.textContent = "";
    }catch(_){}
  };
})();


function confidenceModifier(conf){
  if(conf >= 90) return 1.00;
  if(conf >= 80) return 0.98;
  if(conf >= 70) return 0.95;
  return null; // escalation required
}
(function () {
  const $ = (sel, root = document) => root.querySelector(sel);
  const $$ = (sel, root = document) => Array.from(root.querySelectorAll(sel));

  // Outcome AI: one-line statements + Why tooltip (injected UI, no HTML dependency)
  const tip = (() => {
    const el = document.createElement("div");
    el.className = "oa-tip";
    el.dataset.open = "false";
    el.innerHTML = `
      <div class="oa-tip__panel" role="dialog" aria-hidden="true">
        <div class="oa-tip__title">Why you’re seeing this</div>
        <div class="oa-tip__body"></div>
      </div>`;
    document.addEventListener("DOMContentLoaded", () => document.body.appendChild(el));
    el.addEventListener("click", (e) => { if (e.target === el) setOpen(false); });
    document.addEventListener("keydown", (e) => { if (e.key === "Escape") setOpen(false); });
    function setOpen(open){
      el.dataset.open = open ? "true" : "false";
      const panel = el.querySelector(".oa-tip__panel");
      if(panel) panel.setAttribute("aria-hidden", open ? "false" : "true");
    }
    function position(anchor){
      const panel = el.querySelector(".oa-tip__panel");
      if(!panel || !anchor) return;
      const r = anchor.getBoundingClientRect();
      const x = Math.min(window.innerWidth - panel.offsetWidth - 12, Math.max(12, r.left));
      const y = Math.min(window.innerHeight - panel.offsetHeight - 12, r.bottom + 10);
      panel.style.left = x + "px";
      panel.style.top = y + "px";
    }
    function esc(s){return String(s??"").replace(/[&<>\"']/g, c=>({"&":"&amp;","<":"&lt;",">":"&gt;","\"":"&quot;","'":"&#39;"}[c]));}
    function confidence(n){
      n = Number(n||0);
      if(n >= 30) return "High";
      if(n >= 12) return "Medium";
      return "Low";
    }
    function render(statement, evidence){
      const ev = evidence || { window:"—", n:"—", updated:"—" };
      const notes = ev.notes ? `<div style="margin-top:8px;">${esc(ev.notes)}</div>` : "";
      const body = el.querySelector(".oa-tip__body");
      if(!body) return;
      body.innerHTML = `
        <div>${esc(statement || "")}</div>
        <div class="oa-tip__meta">
          <div class="oa-tip__pill"><div class="oa-tip__k">Window</div><div class="oa-tip__v">${esc(ev.window)}</div></div>
          <div class="oa-tip__pill"><div class="oa-tip__k">Sample</div><div class="oa-tip__v">${esc(ev.n)} units</div></div>
          <div class="oa-tip__pill"><div class="oa-tip__k">Updated</div><div class="oa-tip__v">${esc(ev.updated)}</div></div>
          <div class="oa-tip__pill"><div class="oa-tip__k">Confidence</div><div class="oa-tip__v">${confidence(ev.n)}</div></div>
        </div>
        ${notes}`;
    }
    return { setOpen, position, render, el };
  })();

  function ensureInsightUI(container){
    if(!container) return null;
    let wrap = container.querySelector(".oa-insight");
    if(!wrap){
      wrap = document.createElement("div");
      wrap.className = "oa-insight";
      wrap.innerHTML = `<div class="oa-insight__k">Store Insight</div><div class="oa-insight__text"></div><button class="oa-why" type="button">Why?</button>`;
      container.appendChild(wrap);
    }
    const textEl = wrap.querySelector(".oa-insight__text");
    const btn = wrap.querySelector(".oa-why");
    return { wrap, textEl, btn };
  }

  
  // Preview / debug flags (never shown to dealers by default)
  // - ?debug=1  : show econ-state pills + small preview panel
  // - ?preview=1: same as debug, slightly friendlier name
  // You can also toggle on/off in preview via the banner button (stored in localStorage).
  const __URL = (()=>{ try{ return new URL(window.location.href); }catch(_){ return null; }})();
  const __QS_DEBUG = __URL ? (__URL.searchParams.get("debug") === "1") : false;
  const __QS_PREVIEW = __URL ? (__URL.searchParams.get("preview") === "1") : false;
  const __LS_KEY = "oa_preview_econ";
  const __LS_ON = (()=>{ try{ return localStorage.getItem(__LS_KEY) === "1"; }catch(_){ return false; }})();
  const __LS_OFF = (()=>{ try{ return localStorage.getItem(__LS_KEY) === "0"; }catch(_){ return false; }})();
  // IMPORTANT: preview/debug must never be on by default in dealer mode.
  const __DEBUG_ECON = (!__LS_OFF) && (__QS_DEBUG || __QS_PREVIEW || __LS_ON);
  if(__DEBUG_ECON) document.body.classList.add("debug-econ");

  // Lightweight preview banner + panel (only in debug/preview)
  (function mountPreviewShell(){
    if(!__DEBUG_ECON) return;
    try{
      const banner = document.createElement("div");
      banner.className = "oa-preview-banner";
      banner.innerHTML = `
        <div class="oa-preview-banner__left">
          <div class="oa-preview-badge">Preview Mode</div>
          <div class="oa-preview-title">Economic State Tags (internal)</div>
        </div>
        <div class="oa-preview-banner__right">
          <button class="oa-preview-toggle" type="button" title="Hide preview UI">Hide</button>
        </div>`;
      document.body.appendChild(banner);

      const panel = document.createElement("div");
      panel.className = "oa-preview-panel";
      panel.innerHTML = `
        <div class="oa-preview-panel__hd">Economic States</div>
        <div class="oa-preview-panel__sub">Counts / $ will populate after render.</div>
        <div class="oa-preview-panel__rows" id="oaPreviewRows"></div>`;
      document.body.appendChild(panel);

      banner.querySelector(".oa-preview-toggle").addEventListener("click", ()=>{
        try{ localStorage.setItem(__LS_KEY, "0"); }catch(_){/*noop*/}
        document.body.classList.remove("debug-econ");
        banner.remove();
        panel.remove();
      });
    }catch(_){ /* noop */ }
  })();

