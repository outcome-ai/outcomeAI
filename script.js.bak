  // ---------------------------------------------------------------------------
  // Insights (dealer-safe): read-only slide-out listing top patterns.
  // This intentionally does NOT introduce tasks, checkboxes, or "mark done" flows.
  // ---------------------------------------------------------------------------
  function formatMoney(n){
    const v = Number(n||0);
    try{
      return v.toLocaleString(undefined,{style:"currency",currency:"USD",maximumFractionDigits:0});
    }catch(_){
      return "$" + Math.round(v).toLocaleString();
    }
  }

  const demoInsights = [
    { rank: 1, title: "Buy Window: F-150 XLT under 42k miles", impact: 1850, statement: "You make about $1,850 more when you buy 2021–2023 F-150 XLTs under 42k miles and retail them inside 32 days.", meta: "Based on similar turns + market comps in this demo." },
    { rank: 2, title: "Hold Penalty: Edge beyond day 85", impact: 1250, statement: "You lose roughly $1,250 per Edge when it sits past 85 days — the market forces deeper cuts after the cliff.", meta: "Gross erosion accelerates after day 70; sharp drop after day 85." },
