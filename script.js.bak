  function list(items){ return (items||[]).map(x=>`<li>${x}</li>`).join(""); }
  function coiCard(name, ref, risk, since, owner, facts, why, help, actions){
    const ownerCls = (owner||"").toLowerCase()==="unassigned" ? "x-owner--none" : "";
    const buttons = (actions||[]).map(a=>{
      const cls = a[2]==="primary" ? "x-btn x-btn--primary" : (a[2]==="danger" ? "x-btn x-btn--danger" : "x-btn");
      return `<button class="${cls}" data-action="${a[0]}">${a[1]}</button>`;
    }).join("");
    return `
      <article class="x-card coi-card">
        <div class="x-card__top">
          <div>
            <div class="x-name">${name} <span class="x-muted">|</span> <span class="x-ref">${ref}</span></div>
            <div class="x-impact">${risk}</div>
          </div>
          <div class="x-meta">
            <div class="x-metaLine"><span class="x-ico">⏱️</span> ${since} since last action</div>
            <div class="x-metaLine"><span class="x-ico">👤</span> Owner: <span class="x-owner ${ownerCls}">${owner}</span></div>
          </div>
        </div>
        <div class="x-grid">
          <div><div class="x-h">What’s happening</div><ul class="x-bul">${list(facts)}</ul></div>
          <div><div class="x-h">Why it matters</div><ul class="x-bul">${list(why)}</ul></div>
        </div>
        <div class="x-help">${help}</div>
        <div class="x-actions">${buttons}</div>
      </article>
    `;
  }

  function aeCard(name, ref, deadline, owner, threshold, facts, why){
    const ownerCls = (owner||"").toLowerCase()==="unassigned" ? "x-owner--none" : "";
    return `
      <article class="x-card ae-card">
        <div class="x-card__top">
          <div>
            <div class="x-name">${name} <span class="x-muted">|</span> <span class="x-ref">${ref}</span></div>
            <div class="x-impact">${deadline}</div>
          </div>
          <div class="x-meta">
            <div class="x-metaLine"><span class="x-ico">👤</span> Owner: <span class="x-owner ${ownerCls}">${owner}</span></div>
            <div class="x-metaLine"><span class="x-ico">⏳</span> Threshold: ${threshold}</div>
          </div>
        </div>
        <div class="x-grid">
          <div><div class="x-h">What’s happening</div><ul class="x-bul">${list(facts)}</ul></div>
          <div><div class="x-h">Why it matters</div><ul class="x-bul">${list(why)}</ul></div>
        </div>
        <div class="x-actions">
          <button class="x-btn x-btn--primary" data-action="assign">Assign Owner</button>
          <button class="x-btn" data-action="decide">Log Decision</button>
          <span class="x-defer">
            <button class="x-btn x-btn--warn" data-action="defer">Defer</button>
            <select class="x-select" aria-label="Defer reason">
              <option value="" selected>Reason…</option>
              <option>Waiting on manager</option>
              <option>Waiting on title/payoff</option>
              <option>Customer unavailable</option>
              <option>Recon pending</option>
              <option>Other</option>
            </select>
          </span>
        </div>
        <div class="x-help">Escalation stops when ownership is assigned or a decision is logged.</div>
      </article>
    `;
  }

  function rtCard(name, ref, impact, metaLines, reason){
    const meta = (metaLines||[]).map(x=>`<div class="x-metaLine"><span class="x-ico">✅</span> ${x}</div>`).join("");
    return `
      <article class="x-card rt-card">
        <div class="x-card__top">
          <div>
            <div class="x-name">${name} <span class="x-muted">|</span> <span class="x-ref">${ref}</span></div>
            <div class="x-impact">${impact}</div>
          </div>
          <div class="x-meta">${meta}</div>
        </div>
        <div class="x-help">${reason}</div>
        <div class="x-actions">
          <button class="x-btn" data-action="view">View receipt</button>
        </div>
      </article>
    `;
  }

  const focusMap = {
    approaching_escalation: () => setDrawer("Approaching Escalation","Today’s Focus • Items nearing escalation", modalAE()),
    cost_inaction:          () => setDrawer("Cost of Inaction","Today’s Focus • Dollars leaking if ignored", modalCOI()),
    resolved_today:         () => setDrawer("Resolved Today","Today’s Focus • Closed loops", modalRT())
  };

  document.addEventListener("click", (e)=>{
    const btn = e.target.closest(".js-focus-widget");
    if(!btn) return;

    // FIX8s: only bottom focus widgets (#iosWidgetsFocus) open the focus modals
    if(!btn.closest("#iosWidgetsFocus")) return;

    e.preventDefault(); e.stopPropagation();
    const key = btn.getAttribute("data-focus");
    try{ const d = qs(".js-drawer")||qs(".drawer"); if(d && d.dataset.open==="true") { /* close then open for clean transition */ if(typeof window.closeDrawer==="function"){ window.closeDrawer(); } }
    }catch(_){ }
    if(focusMap[key]) focusMap[key]();
  }, true);

  // Demo behavior: make actions feel “alive” without changing the dashboard tiles
  document.addEventListener("click", (e)=>{
    const btn = e.target.closest(".x-btn[data-action]");
    if(!btn) return;

    const card = e.target.closest(".x-card");
    if(!card) return;

    const action = btn.getAttribute("data-action") || "action";
    const help = card.querySelector(".x-help");

    if(action === "view"){
      if(help) help.textContent = "Receipt opened (demo).";
      return;
    }

    if(action === "defer"){
      const sel = card.querySelector(".x-select");
      const reason = sel && sel.value ? sel.value : "Reason required";
      if(help) help.textContent = `Deferred: ${reason}. Escalation paused.`;
      return;
    }

    if(help) help.textContent = `Logged: ${action}. Timer stopped.`;
    card.querySelectorAll(".x-btn, .x-select").forEach(el => { try{ el.disabled = true; }catch(_){ } });
    btn.textContent = "Logged";
  });
})();
;

/* FIX10b: card view click (keeps existing modals; no other changes) */
document.addEventListener("click", (e)=>{
  const btn = e.target.closest(".js-cardView");
  if(!btn) return;
  const col = btn.getAttribute("data-col") || "";
  const key = btn.getAttribute("data-key") || "";
  try{
    if(col === "acquire_now") { openAcquireModal(key); return; }
    if(col === "stop_buying") { openStopBuyingModal(key); return; }
  }catch(_){}
});
